# ============================================================================
# Simplifex — Segredos das Edge Functions (Supabase)
# NÃO commitar o .env real. Configure estes valores com:
#   supabase secrets set --env-file .env
# ============================================================================

# Access Token PRIVADO do Mercado Pago (Painel MP > Suas integrações > Credenciais)
# Comece com TEST- em ambiente de testes, depois troque para o de produção.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Preenchido automaticamente pelo runtime das Edge Functions do Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service Role Key (Project Settings > API) — NUNCA usar no front-end
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base do seu app publicado (usada no back_url do checkout do Mercado Pago)
APP_BASE_URL=https://simplifex.com.br
